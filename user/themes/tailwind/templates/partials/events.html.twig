<div class="flex-1 divide-y divide-stone-200">
    {% for event in events %}
        <a href="#"
           class="flex justify-between group items-center gap-6 py-6 hover:bg-gray-500 transition-colors duration-150 px-2 -mx-2">

            <div>
                <div class="w-14 shrink-0 flex gap-4">
                    <div class="text-xs font-semibold uppercase tracking-widest ">
                        {{ event.date }}
                    </div>
                    <span class="text-xs font-semibold uppercase tracking-widest ">
                      {{ event.type }}
                    </span>
                </div>
                <!-- Content -->
                <div class="min-w-0">
                    <h5 class="mt-0.5 text-lg font-semibold truncate transition-colors">
                        {{ event.title }}
                    </h5>
                </div>
            </div>
            <!-- Arrow -->
            <svg class="w-5 h-5  transition-colors shrink-0" fill="none"
                 stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>

        </a>
    {% endfor %}
</div>
