{% set extension = config.theme.production ? '.min' : '' %}
<!DOCTYPE html>
<html lang="{{ (grav.language.getActive ?: grav.config.site.default_lang)|e }}">
<head>
    {% block head %}
        <meta charset="utf-8"/>
        <title>{% if header.title %}{{ header.title|e }} | {% endif %}{{ site.title|e }}</title>

        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% include 'partials/metadata.html.twig' %}

        <link rel="icon" type="image/png" href="{{ url('theme://images/logo.png')|e }}"/>
        <link rel="canonical" href="{{ page.url(true, true)|e }}"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
            rel="stylesheet">
    {% endblock head %}

    {% block stylesheets %}
        {% do assets.addCss('theme://dist/css/site.css', 98) %}
    {% endblock %}

    {% block javascripts %}
        {% do assets.addJs('theme://js/main' ~ extension ~ '.js', 98) %}
    {% endblock %}

    {% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: Proxima Nova, Arial, sans-serif;
            color: rgb(54, 54, 58)
        }
    </style>
    {% endblock %}
</head>
<body id="top"
      class="flex flex-col min-h-screen font-body bg-surface-container-low selection:bg-primary/30 selection:text-primary {{ page.header.body_classes|e }} {{ config.theme.production ?: 'debug-screens' }}">

{% block header %}
    <header class="bg-gradient-to-br from-gray-800 via-gray-900 to-black  shadow-lg sticky top-0 z-50 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <div class="flex-shrink-0 flex items-center">
                    <a class="text-2xl font-serif font-bold tracking-tight text-white hover:text-gray-100 transition duration-150 ease-in-out uppercase"
                       href="{{ home_url|e }}">
                        {#                        {{ config.site.title|e }} #}
                        {% include 'partials/logo.html.twig' %}
{#                        <h1 class="text-4xl bold text-white text-gray-100">{{ config.site.title|e }}</h1>#}
                    </a>
                </div>
                {% block header_navigation %}
                    {% include 'partials/navigation.html.twig' %}
                {% endblock %}
            </div>
        </div>
    </header>
{% endblock %}

{% block body %}
    <main class="flex-grow ">
        {% block hero %}{% endblock %}
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg prose-invert max-w-none mx-auto">
                {% block content %}{% endblock %}
            </div>
        </div>
    </main>
{% endblock %}

{% block footer %}
    <footer class="bg-gray-800 text-white">
        <div class="container mx-auto px-4 py-6 sm:px-6 lg:px-8">
            <div class="text-center md:text-left">
                <p class="text-sm">&copy; {{ "now"|date("Y") }} <a href="{{ home_url|e }}"
                                                                   class="hover:text-gray-300">{{ config.site.title|e }}</a>.
                    All rights reserved.</p>
                <p class="text-xs text-gray-400 mt-2">Powered by <a href="https://getgrav.org"
                                                                    class="hover:text-gray-300">Grav</a></p>
            </div>
        </div>
    </footer>
{% endblock %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}
</body>
</html>
