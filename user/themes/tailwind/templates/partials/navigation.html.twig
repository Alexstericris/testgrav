{% macro loop(page) %}
    {% for p in page.children.visible %}
        {% set current_page = (p.active or p.activeChild) ? 'text-gray-900 font-bold' : 'text-gray-500 hover:text-gray-900' %}
        
        {% if p.children.visible.count > 0 %}
            <div class="relative group">
                <button type="button" class="group inline-flex items-center text-base leading-6 font-medium focus:outline-none transition ease-in-out duration-150 {{ current_page }}">
                    <span>{{ p.menu }}</span>
                    <svg class="ml-1 h-5 w-5 text-gray-400 group-hover:text-gray-500 transition ease-in-out duration-150" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </button>
                <div class="absolute left-1/2 transform -translate-x-1/2 mt-3 px-2 w-screen max-w-xs sm:px-0 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition duration-200 ease-in-out z-50">
                    <div class="rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 overflow-hidden">
                        <div class="relative grid gap-6 bg-white px-5 py-6 sm:gap-8 sm:p-8">
                            {% for child in p.children.visible %}
                                <a href="{{ child.url }}" class="-m-3 p-3 flex items-start space-x-4 rounded-lg hover:bg-gray-50 transition ease-in-out duration-150">
                                    <div class="flex-1 space-y-1">
                                        <p class="text-base leading-6 font-medium text-gray-900">
                                            {{ child.menu }}
                                        </p>
                                        {% if child.header.subtitle %}
                                        <p class="text-sm leading-5 text-gray-500">
                                            {{ child.header.subtitle }}
                                        </p>
                                        {% endif %}
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <a href="{{ p.url }}" class="text-base leading-6 font-medium transition ease-in-out duration-150 {{ current_page }}">
                {{ p.menu }}
            </a>
        {% endif %}
    {% endfor %}
{% endmacro %}

<div class="hidden md:flex space-x-10">
    {% if config.theme.dropdown.enabled %}
        {{ _self.loop(pages) }}
    {% else %}
        {% for page in pages.children.visible %}
            {% set current_page = (page.active or page.activeChild) ? 'text-gray-900 font-bold' : 'text-gray-500 hover:text-gray-900' %}
            <a href="{{ page.url }}" class="text-base leading-6 font-medium transition ease-in-out duration-150 {{ current_page }}">
                {{ page.menu }}
            </a>
        {% endfor %}
    {% endif %}
    {% for mitem in site.menu %}
        <a href="{{ mitem.url }}" class="text-base leading-6 font-medium text-gray-500 hover:text-gray-900 transition ease-in-out duration-150">
            {{ mitem.text }}
        </a>
    {% endfor %}
</div>
