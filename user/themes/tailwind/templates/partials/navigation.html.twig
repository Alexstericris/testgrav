{% import 'macros/nav-macros.html.twig' as macros %}
{% import 'macros/nav-macros-mobile.html.twig' as macrosmobile %}
<div class="flex items-center justify-center">
    <button id="mobile-nav-toggle"  class="relative w-10 h-10 flex flex-col justify-center items-center group">
        <span class="block w-6 h-0.5 bg-white mb-1 transition-all duration-300
            group-[.open]:rotate-45 group-[.open]:translate-y-1.5 group-[.open]:bg-primary"></span>
        <span class="block w-6 h-0.5 bg-white mb-1 transition-all duration-300
            group-[.open]:opacity-0"></span>
        <span class="block w-6 h-0.5 bg-white transition-all duration-300
            group-[.open]:-rotate-45 group-[.open]:-translate-y-1.5 group-[.open]:bg-primary"></span>
    </button>
</div>
<nav id="mobile-nav"
     class="hidden fixed top-20 left-0 z-10 w-full h-[89vh] bg-linear-to-br from-gray-800 via-gray-900 to-black overflow-y-auto">
    <ul class="flex flex-col w-full h-[80vh] bg-surface-container">
        {{ macrosmobile.nav_loop(pages) }}
    </ul>
    <div class="absolute bottom-0 left-1/2 -translate-1/2"
    >{% include 'partials/langswitcher.html.twig'%}</div>

</nav>
<nav id="mainnav" class="hidden md:flex space-x-8 items-center h-full">
    <ul class="flex items-center h-full" {{ tree ? 'class="tree"' : '' }}>
        {{ macros.nav_loop(pages) }}
        {% include 'partials/langswitcher.html.twig'%}
    </ul>
</nav>
