{% set current_lang = grav.language.getActive %}
{% set langs = page.translatedLanguages() %}

{% if langs|length > 1 %}
    <div class="inline-flex items-center">
        <div class="inline-flex bg-black/10 rounded-full p-1 gap-0.5">
            {% for lang, url in langs %}
                {% if lang == current_lang %}
                    <span
                        aria-current="true"
                        class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider bg-white shadow-sm opacity-100 cursor-default select-none"
                    >
                    {{ lang|upper }}
                </span>
                {% else %}
                    <a
                        href="{{ '/'~lang~url }}"
                        hreflang="{{ lang }}"
                        class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider opacity-40
                        hover:opacity-75 transition-opacity duration-200"
                    >
                        {{ lang|upper }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{% endif %}
