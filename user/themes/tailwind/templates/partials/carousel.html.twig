{# partials/carousel.html.twig #}
{% set carousel_id = 'carousel-' ~ random(10000) %}
{% set speed = speed ?? 25 %}
{% set item_height = item_height ?? 80 %}
{% set item_gap = item_gap ?? 64 %}
{% set wrapper_class = wrapper_class ?? 'w-full md:w-1/2 ' %}

<div id="{{ carousel_id }}" class="carousel overflow-hidden {{ wrapper_class }}">
    <div class="carousel__track flex w-max"
         style="animation: scroll-{{ carousel_id }} {{ speed }}s linear infinite;">
        {% for pass in 1..2 %}
            {% for image in images %}
                <div class="carousel__slide flex-none flex items-center justify-center"
                     style="height: {{ item_height }}px; margin-right: {{ item_gap }}px;">
                    <img src="{{ page.media[image].url }}"
                         alt=""
                         style="max-height: {{ item_height }}px; width: auto; max-width: 220px; object-fit: contain; display: block; filter: brightness(0) invert(1) opacity(0.7);">                </div>
            {% endfor %}
        {% endfor %}
    </div>
</div>

<style>
    @keyframes scroll-{{ carousel_id }} {
        0%   { transform: translateX(0); }
        100% {
            transform: translateX(-50%);
        }
    }

    /* Pause on hover (optional — remove if unwanted) */
    {{'#'~ carousel_id~':hover' }} .carousel__track {
        animation-play-state: paused;
    }
</style>
