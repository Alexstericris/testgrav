{% extends 'partials/base.html.twig' %}

{% block hero %}
    {% if page.header.hero_image %}
        {% set hero_image = page.media[page.header.hero_image] %}
        <div class="relative bg-gray-900 mb-8 h-[60vh] overflow-hidden">
            <div class="absolute inset-0">
                <img class="w-full h-full object-cover" src="{{ hero_image.url }}" alt="{{ page.title }}">
                <div class="absolute inset-0 bg-gray-900 opacity-40"></div>
            </div>
            <div class="relative max-w-7xl mx-auto h-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 text-center">
                <h1 class="text-5xl font-serif font-bold tracking-tight sm:text-6xl lg:text-7xl drop-shadow-lg">{{ page.title }}</h1>
                {% if page.header.subtitle %}
                    <p class="mt-6 text-2xl font-light text max-w-3xl mx-auto drop-shadow-md font-sans">{{ page.header.subtitle }}</p>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
    {{ page.content|raw }}
{% endblock %}
